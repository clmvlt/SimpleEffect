---
source: crates/se-mcp/tests/schemas.rs
expression: definition
---
{
  "annotations": {
    "destructiveHint": true,
    "openWorldHint": false,
    "readOnlyHint": false
  },
  "description": "Cuts spoken words out of the sequence (text-based editing): give the ranges of the words from get_transcript. Each cut keeps the longer pause around the words and a short breath before the next word, never cuts inside a kept word, and closes the gap on the speech's tracks and their linked picture (one undoable transaction; later items move left). Cuts must lie in your task's range; items after it may move. Returns the cuts made and the time gained.",
  "inputSchema": {
    "$defs": {
      "RangeInput": {
        "additionalProperties": false,
        "description": "A range given by an agent; the end is excluded.",
        "properties": {
          "end": {
            "$ref": "#/$defs/Time",
            "description": "End of the range (excluded), after `start`."
          },
          "start": {
            "$ref": "#/$defs/Time",
            "description": "First instant of the range."
          }
        },
        "required": [
          "start",
          "end"
        ],
        "type": "object"
      },
      "Time": {
        "description": "Seconds (51.5) or a timecode string: \"51.5s\", \"00:51\", \"00:00:51.500\", or \"00:00:51:12\" (frames at the sequence's rate).",
        "oneOf": [
          {
            "type": "number"
          },
          {
            "type": "string"
          }
        ]
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "all_tracks": {
        "description": "Cut every unlocked track (graphics and music included) instead of the speech's tracks\nand their linked picture; default false.",
        "type": [
          "boolean",
          "null"
        ]
      },
      "ranges": {
        "description": "Ranges of the words to remove, in sequence time, as `get_transcript` gives them: from the\nfirst word's start to the last word's end. A word is removed when its middle lies in a\nrange (at most 500 ranges).",
        "items": {
          "$ref": "#/$defs/RangeInput"
        },
        "type": "array"
      }
    },
    "required": [
      "ranges"
    ],
    "type": "object"
  },
  "name": "remove_words"
}
