---
source: crates/se-mcp/tests/schemas.rs
expression: definition
---
{
  "annotations": {
    "destructiveHint": false,
    "openWorldHint": false,
    "readOnlyHint": true
  },
  "description": "The words spoken in a range of the sequence (default: your task's range, else the whole sequence), in sequence time: segments (phrases) with their text, and each word's start and end in seconds (words=false for segments only). Only what the sound clips play counts: cut passages have no words. Paginated by words (offset/limit, next_offset). untranscribed lists media the user has not transcribed yet.",
  "inputSchema": {
    "$defs": {
      "RangeInput": {
        "additionalProperties": false,
        "description": "A range given by an agent; the end is excluded.",
        "properties": {
          "end": {
            "$ref": "#/$defs/Time",
            "description": "End of the range (excluded), after `start`."
          },
          "start": {
            "$ref": "#/$defs/Time",
            "description": "First instant of the range."
          }
        },
        "required": [
          "start",
          "end"
        ],
        "type": "object"
      },
      "Time": {
        "description": "Seconds (51.5) or a timecode string: \"51.5s\", \"00:51\", \"00:00:51.500\", or \"00:00:51:12\" (frames at the sequence's rate).",
        "oneOf": [
          {
            "type": "number"
          },
          {
            "type": "string"
          }
        ]
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "limit": {
        "description": "Words per page (default 400, at most 2000).",
        "format": "uint",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "offset": {
        "description": "Index of the first word of the page (a previous answer's `next_offset`); default 0.",
        "format": "uint",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "range": {
        "anyOf": [
          {
            "$ref": "#/$defs/RangeInput"
          },
          {
            "type": "null"
          }
        ],
        "description": "A range of the sequence; default: your task's range, else the whole sequence."
      },
      "sequence": {
        "description": "Sequence id or exact name; default: your task's sequence.",
        "type": [
          "string",
          "null"
        ]
      },
      "words": {
        "description": "Whether to list each word with its times (default true); false gives segments only,\nshorter for long ranges.",
        "type": [
          "boolean",
          "null"
        ]
      }
    },
    "type": "object"
  },
  "name": "get_transcript"
}
