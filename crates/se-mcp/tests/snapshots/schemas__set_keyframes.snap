---
source: crates/se-mcp/tests/schemas.rs
expression: definition
---
{
  "annotations": {
    "destructiveHint": true,
    "openWorldHint": false,
    "readOnlyHint": false
  },
  "description": "Replaces the keyframes (or sets a static value) of one animatable property of an item: position, scale, rotation, anchor, opacity, blur, volumeDb, reframeFocus, text properties, colours. Keyframe times are relative to the item's start. Prefer apply_animation_preset for usual entrances and exits.",
  "inputSchema": {
    "$defs": {
      "EasingInput": {
        "anyOf": [
          {
            "$ref": "#/$defs/EasingName",
            "description": "A named easing."
          },
          {
            "description": "A cubic Bézier `[x1, y1, x2, y2]` (CSS-like).",
            "items": {
              "format": "double",
              "type": "number"
            },
            "maxItems": 4,
            "minItems": 4,
            "type": "array"
          }
        ],
        "description": "How a value travels to the next keyframe."
      },
      "EasingName": {
        "description": "A named easing.",
        "oneOf": [
          {
            "const": "linear",
            "description": "Constant speed.",
            "type": "string"
          },
          {
            "const": "hold",
            "description": "Jumps to the next value at the next keyframe.",
            "type": "string"
          },
          {
            "const": "ease_in",
            "description": "Starts slowly.",
            "type": "string"
          },
          {
            "const": "ease_out",
            "description": "Ends slowly (natural for entrances).",
            "type": "string"
          },
          {
            "const": "ease_in_out",
            "description": "Starts and ends slowly.",
            "type": "string"
          }
        ]
      },
      "KeyframeInput": {
        "additionalProperties": false,
        "description": "One keyframe.",
        "properties": {
          "easing": {
            "anyOf": [
              {
                "$ref": "#/$defs/EasingInput"
              },
              {
                "type": "null"
              }
            ],
            "description": "How the value travels to the next keyframe; default linear."
          },
          "time": {
            "$ref": "#/$defs/Time",
            "description": "Time **relative to the item's start** (0 = its first instant), within the item."
          },
          "value": {
            "$ref": "#/$defs/ValueInput",
            "description": "The value: a number, `[x, y]` (position, scale, anchor, reframeFocus, shadowOffset) or\n`#rrggbb[aa]` (colours)."
          }
        },
        "required": [
          "time",
          "value"
        ],
        "type": "object"
      },
      "PointInput": {
        "additionalProperties": false,
        "description": "A point of the frame, normalised: `x` from 0 (left) to 1 (right), `y` from 0 (top) to 1\n(bottom).",
        "properties": {
          "x": {
            "description": "From 0 (left edge) to 1 (right edge).",
            "format": "double",
            "type": "number"
          },
          "y": {
            "description": "From 0 (top edge) to 1 (bottom edge).",
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "x",
          "y"
        ],
        "type": "object"
      },
      "Time": {
        "description": "Seconds (51.5) or a timecode string: \"51.5s\", \"00:51\", \"00:00:51.500\", or \"00:00:51:12\" (frames at the sequence's rate).",
        "oneOf": [
          {
            "type": "number"
          },
          {
            "type": "string"
          }
        ]
      },
      "ValueInput": {
        "anyOf": [
          {
            "description": "A number.",
            "format": "double",
            "type": "number"
          },
          {
            "description": "A pair `[x, y]`.",
            "items": {
              "format": "double",
              "type": "number"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          {
            "$ref": "#/$defs/PointInput",
            "description": "A pair `{\"x\", \"y\"}`."
          },
          {
            "description": "A colour `#rrggbb[aa]`.",
            "type": "string"
          }
        ],
        "description": "A keyframe value: a number (opacity, rotation, sizes, dB), a pair (position, scale, anchor,\nfocus, shadow offset) or a colour."
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "expected_revision": {
        "description": "The revision you read; refused (`REVISION_CONFLICT`) if the item changed since.",
        "format": "uint64",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "item_id": {
        "description": "The item (an `item_id`, or `$name` in `apply_batch`).",
        "type": "string"
      },
      "keyframes": {
        "description": "The keyframes, in time order (at least one). Give `keyframes` or `value`.",
        "items": {
          "$ref": "#/$defs/KeyframeInput"
        },
        "type": [
          "array",
          "null"
        ]
      },
      "property": {
        "description": "The property: position, scale, rotation, anchor, opacity, blur, volumeDb, reframeFocus,\nfontSize, fillColor, letterSpacing, reveal, strokeColor, strokeWidth, shadowColor,\nshadowBlur, shadowOffset, backgroundColor.",
        "type": "string"
      },
      "value": {
        "anyOf": [
          {
            "$ref": "#/$defs/ValueInput"
          },
          {
            "type": "null"
          }
        ],
        "description": "A static value replacing any keyframes. Give `keyframes` or `value`."
      }
    },
    "required": [
      "item_id",
      "property"
    ],
    "type": "object"
  },
  "name": "set_keyframes"
}
