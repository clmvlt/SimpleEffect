---
source: crates/se-mcp/tests/schemas.rs
expression: definition
---
{
  "annotations": {
    "destructiveHint": true,
    "openWorldHint": false,
    "readOnlyHint": false
  },
  "description": "Adds an editable text over a time range of the task's sequence: content, place, size, font, colour, outline, shadow, box, and optional entrance/exit animations (presets), all in one step. Answers the new item_id. Check the result with get_frames.",
  "inputSchema": {
    "$defs": {
      "AlignInput": {
        "description": "Horizontal alignment of the lines.",
        "oneOf": [
          {
            "const": "left",
            "description": "Lines start at the left.",
            "type": "string"
          },
          {
            "const": "center",
            "description": "Lines are centred (default).",
            "type": "string"
          },
          {
            "const": "right",
            "description": "Lines end at the right.",
            "type": "string"
          }
        ]
      },
      "AnimationInput": {
        "additionalProperties": false,
        "description": "An animation applied to a new item.",
        "properties": {
          "duration": {
            "anyOf": [
              {
                "$ref": "#/$defs/Time"
              },
              {
                "type": "null"
              }
            ],
            "description": "Its length (seconds or timecode); default: the preset's."
          },
          "preset": {
            "description": "A preset id from `list_animation_presets` (`fade`, `pop`, `slideFromLeft`…).",
            "type": "string"
          }
        },
        "required": [
          "preset"
        ],
        "type": "object"
      },
      "BackgroundInput": {
        "additionalProperties": false,
        "description": "A box behind the text.",
        "properties": {
          "color": {
            "description": "`#rrggbb[aa]`; default translucent black.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "NamedPosition": {
        "description": "A named place of the frame (inside the usual safe areas of vertical and horizontal videos).",
        "oneOf": [
          {
            "const": "center",
            "description": "The centre (0.5, 0.5).",
            "type": "string"
          },
          {
            "const": "top",
            "description": "Upper part, centred (0.5, 0.15).",
            "type": "string"
          },
          {
            "const": "bottom",
            "description": "Lower part, centred (0.5, 0.8).",
            "type": "string"
          },
          {
            "const": "left",
            "description": "Left part, centred vertically (0.2, 0.5).",
            "type": "string"
          },
          {
            "const": "right",
            "description": "Right part, centred vertically (0.8, 0.5).",
            "type": "string"
          },
          {
            "const": "lower_third",
            "description": "Lower third, left (0.3, 0.75): names and titles.",
            "type": "string"
          }
        ]
      },
      "PointInput": {
        "additionalProperties": false,
        "description": "A point of the frame, normalised: `x` from 0 (left) to 1 (right), `y` from 0 (top) to 1\n(bottom).",
        "properties": {
          "x": {
            "description": "From 0 (left edge) to 1 (right edge).",
            "format": "double",
            "type": "number"
          },
          "y": {
            "description": "From 0 (top edge) to 1 (bottom edge).",
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "x",
          "y"
        ],
        "type": "object"
      },
      "PositionInput": {
        "anyOf": [
          {
            "$ref": "#/$defs/NamedPosition",
            "description": "A named place."
          },
          {
            "$ref": "#/$defs/PointInput",
            "description": "A normalised point."
          }
        ],
        "description": "Where an item's centre (its anchor) sits."
      },
      "StrokeInput": {
        "additionalProperties": false,
        "description": "An outline around text glyphs or a shape.",
        "properties": {
          "color": {
            "description": "`#rrggbb` or `#rrggbbaa`; default black.",
            "type": [
              "string",
              "null"
            ]
          },
          "width": {
            "description": "Width in design pixels (1080 px = the frame's shorter side); default 4.",
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "Time": {
        "description": "Seconds (51.5) or a timecode string: \"51.5s\", \"00:51\", \"00:00:51.500\", or \"00:00:51:12\" (frames at the sequence's rate).",
        "oneOf": [
          {
            "type": "number"
          },
          {
            "type": "string"
          }
        ]
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "align": {
        "anyOf": [
          {
            "$ref": "#/$defs/AlignInput"
          },
          {
            "type": "null"
          }
        ],
        "description": "Line alignment; default center."
      },
      "animation_in": {
        "anyOf": [
          {
            "$ref": "#/$defs/AnimationInput"
          },
          {
            "type": "null"
          }
        ],
        "description": "Entrance animation (preset `in` phase), e.g. {\"preset\": \"pop\"}."
      },
      "animation_out": {
        "anyOf": [
          {
            "$ref": "#/$defs/AnimationInput"
          },
          {
            "type": "null"
          }
        ],
        "description": "Exit animation (preset `out` phase), e.g. {\"preset\": \"fade\", \"duration\": 0.3}."
      },
      "background": {
        "anyOf": [
          {
            "$ref": "#/$defs/BackgroundInput"
          },
          {
            "type": "null"
          }
        ],
        "description": "A box behind the text."
      },
      "color": {
        "description": "Colour `#rrggbb[aa]`; default white.",
        "type": [
          "string",
          "null"
        ]
      },
      "duration": {
        "anyOf": [
          {
            "$ref": "#/$defs/Time"
          },
          {
            "type": "null"
          }
        ],
        "description": "How long it stays. Give `end` or `duration`."
      },
      "end": {
        "anyOf": [
          {
            "$ref": "#/$defs/Time"
          },
          {
            "type": "null"
          }
        ],
        "description": "When it disappears (excluded). Give `end` or `duration`."
      },
      "font_family": {
        "description": "Font family; default \"Inter\".",
        "type": [
          "string",
          "null"
        ]
      },
      "font_size": {
        "description": "Size in design pixels (1080 = the frame's shorter side); default 96. Short videos: 80–140\nfor titles, 48–64 for captions.",
        "format": "double",
        "type": [
          "number",
          "null"
        ]
      },
      "font_weight": {
        "description": "Weight 1–1000 (400 regular, 700 bold, 900 black); default 600.",
        "format": "uint16",
        "maximum": 65535,
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "italic": {
        "description": "Italic; default false.",
        "type": [
          "boolean",
          "null"
        ]
      },
      "max_width": {
        "description": "Wrapping width in design pixels; default none (one line per `\\n`).",
        "format": "double",
        "type": [
          "number",
          "null"
        ]
      },
      "position": {
        "anyOf": [
          {
            "$ref": "#/$defs/PositionInput"
          },
          {
            "type": "null"
          }
        ],
        "description": "Where its centre sits; default \"center\"."
      },
      "shadow": {
        "description": "A soft drop shadow; default false.",
        "type": [
          "boolean",
          "null"
        ]
      },
      "start": {
        "$ref": "#/$defs/Time",
        "description": "When it appears, in sequence time (inside the task's range)."
      },
      "stroke": {
        "anyOf": [
          {
            "$ref": "#/$defs/StrokeInput"
          },
          {
            "type": "null"
          }
        ],
        "description": "An outline (improves legibility over video)."
      },
      "text": {
        "description": "The text (`\\n` for line breaks).",
        "type": "string"
      },
      "track": {
        "description": "A video track (id or name); default: the highest free track of the task.",
        "type": [
          "string",
          "null"
        ]
      },
      "uppercase": {
        "description": "Show in capitals; default false.",
        "type": [
          "boolean",
          "null"
        ]
      }
    },
    "required": [
      "text",
      "start"
    ],
    "type": "object"
  },
  "name": "add_text"
}
