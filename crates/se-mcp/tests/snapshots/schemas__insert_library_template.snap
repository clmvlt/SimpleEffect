---
source: crates/se-mcp/tests/schemas.rs
expression: definition
---
{
  "annotations": {
    "destructiveHint": true,
    "openWorldHint": false,
    "readOnlyHint": false
  },
  "description": "Places a motion template of the user's template library on the task's sequence over a time range (default length: the template's): the template is copied into the project (a copy of the same version is reused) and an instance gets the values given, the brand kit's values for parameters bound to a role, else the defaults. Answers the new item_id; check it with get_frames. Not batchable.",
  "inputSchema": {
    "$defs": {
      "AnimationInput": {
        "additionalProperties": false,
        "description": "An animation applied to a new item.",
        "properties": {
          "duration": {
            "anyOf": [
              {
                "$ref": "#/$defs/Time"
              },
              {
                "type": "null"
              }
            ],
            "description": "Its length (seconds or timecode); default: the preset's."
          },
          "preset": {
            "description": "A preset id from `list_animation_presets` (`fade`, `pop`, `slideFromLeft`…).",
            "type": "string"
          }
        },
        "required": [
          "preset"
        ],
        "type": "object"
      },
      "Time": {
        "description": "Seconds (51.5) or a timecode string: \"51.5s\", \"00:51\", \"00:00:51.500\", or \"00:00:51:12\" (frames at the sequence's rate).",
        "oneOf": [
          {
            "type": "number"
          },
          {
            "type": "string"
          }
        ]
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "animation_in": {
        "anyOf": [
          {
            "$ref": "#/$defs/AnimationInput"
          },
          {
            "type": "null"
          }
        ],
        "description": "Entrance animation of the whole frame (preset `in` phase); usually the template animates\nitself."
      },
      "animation_out": {
        "anyOf": [
          {
            "$ref": "#/$defs/AnimationInput"
          },
          {
            "type": "null"
          }
        ],
        "description": "Exit animation of the whole frame (preset `out` phase)."
      },
      "duration": {
        "anyOf": [
          {
            "$ref": "#/$defs/Time"
          },
          {
            "type": "null"
          }
        ],
        "description": "How long it lasts."
      },
      "end": {
        "anyOf": [
          {
            "$ref": "#/$defs/Time"
          },
          {
            "type": "null"
          }
        ],
        "description": "When it ends (excluded). Give `end` or `duration`, or neither for the template's default\nduration."
      },
      "params": {
        "additionalProperties": true,
        "description": "Parameter values by name (the others take the brand kit's value for parameters bound to\na role, else their default). Numbers and colours also take\n`{\"keyframes\": [{\"time\": 0, \"value\": …}]}`; assets take an image `asset_id`.",
        "type": [
          "object",
          "null"
        ]
      },
      "start": {
        "$ref": "#/$defs/Time",
        "description": "When it starts, in sequence time."
      },
      "template_id": {
        "description": "The library template (a `library_template_id` from `list_templates` with source\n\"library\").",
        "type": "string"
      },
      "track": {
        "description": "A video track (id or name); default: the highest free track of the task.",
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "template_id",
      "start"
    ],
    "type": "object"
  },
  "name": "insert_library_template"
}
