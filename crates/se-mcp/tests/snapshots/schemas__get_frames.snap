---
source: crates/se-mcp/tests/schemas.rs
expression: definition
---
{
  "annotations": {
    "destructiveHint": false,
    "openWorldHint": false,
    "readOnlyHint": true
  },
  "description": "Look at the sequence: pictures exactly as the viewer shows them (texts, shapes, transformations, animations and transitions included), at given sequence times or spread over a range (default: 6 frames over your task's range, else the whole sequence). Returns a JSON header then one image per time. Needs the project open in a SimpleEffect window.",
  "inputSchema": {
    "$defs": {
      "RangeInput": {
        "additionalProperties": false,
        "description": "A range given by an agent; the end is excluded.",
        "properties": {
          "end": {
            "$ref": "#/$defs/Time",
            "description": "End of the range (excluded), after `start`."
          },
          "start": {
            "$ref": "#/$defs/Time",
            "description": "First instant of the range."
          }
        },
        "required": [
          "start",
          "end"
        ],
        "type": "object"
      },
      "Time": {
        "description": "Seconds (51.5) or a timecode string: \"51.5s\", \"00:51\", \"00:00:51.500\", or \"00:00:51:12\" (frames at the sequence's rate).",
        "oneOf": [
          {
            "type": "number"
          },
          {
            "type": "string"
          }
        ]
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "count": {
        "description": "Frames to spread over `range`; default 6, at most 12.",
        "format": "uint",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "max_width": {
        "description": "Largest picture width in pixels (64–1920); default 768.",
        "format": "uint32",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "range": {
        "anyOf": [
          {
            "$ref": "#/$defs/RangeInput"
          },
          {
            "type": "null"
          }
        ],
        "description": "A range to spread frames over (the middle of `count` equal slices); default: your task's\nrange, else the whole sequence."
      },
      "sequence": {
        "description": "Sequence id or exact name; default: your task's sequence.",
        "type": [
          "string",
          "null"
        ]
      },
      "times": {
        "description": "Sequence times to show (at most 12). Give either `times` or `range`.",
        "items": {
          "$ref": "#/$defs/Time"
        },
        "type": [
          "array",
          "null"
        ]
      }
    },
    "type": "object"
  },
  "name": "get_frames"
}
