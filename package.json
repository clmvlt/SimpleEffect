{
  "name": "simpleeffect",
  "version": "0.1.0",
  "private": true,
  "description": "Local, AI-first video editor for Windows, macOS and Linux.",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "package": "node scripts/package.mjs",
    "check": "node scripts/check.mjs",
    "test": "vitest run && cargo test --workspace",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "codegen": "node scripts/codegen.mjs",
    "fetch-binaries": "node scripts/fetch-binaries.mjs",
    "generate-test-project": "cargo run -q -p se-devtools --",
    "bench": "cargo bench -p se-devtools --bench core --",
    "storybook": "pnpm --filter @se/ui storybook",
    "set-version": "node scripts/set-version.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@vitest/browser-playwright": "5.1.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.4.2",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "playwright": "1.65.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
