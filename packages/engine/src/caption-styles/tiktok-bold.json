{
  "id": "tiktokBold",
  "style": {
    "fontFamily": "Montserrat",
    "fontWeight": 900,
    "italic": false,
    "fontSize": 84,
    "textCase": "uppercase",
    "lineHeight": 1.1,
    "textColor": "#ffffff",
    "activeColor": "#ffd600",
    "emphasisColor": "#3ee8ff",
    "outline": { "enabled": true, "color": "#000000", "width": 7 },
    "shadow": { "enabled": true, "color": "#00000099", "blur": 10, "offset": { "x": 0, "y": 4 } },
    "background": {
      "enabled": false,
      "color": "#000000b3",
      "padding": { "x": 24, "y": 12 },
      "cornerRadius": 16
    },
    "position": { "x": 0.5, "y": 0.64 },
    "animation": "popPerWord",
    "highlightSpoken": false,
    "maxCharsPerLine": 18,
    "maxLines": 1
  }
}
