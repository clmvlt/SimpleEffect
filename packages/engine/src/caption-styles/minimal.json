{
  "id": "minimal",
  "style": {
    "fontFamily": "Inter",
    "fontWeight": 600,
    "italic": false,
    "fontSize": 52,
    "textCase": "normal",
    "lineHeight": 1.25,
    "textColor": "#ffffff",
    "activeColor": "#ffffff",
    "emphasisColor": "#ffd600",
    "outline": { "enabled": false, "color": "#000000", "width": 0 },
    "shadow": { "enabled": true, "color": "#000000b3", "blur": 6, "offset": { "x": 0, "y": 2 } },
    "background": {
      "enabled": false,
      "color": "#000000b3",
      "padding": { "x": 24, "y": 12 },
      "cornerRadius": 12
    },
    "position": { "x": 0.5, "y": 0.9 },
    "animation": "none",
    "highlightSpoken": false,
    "maxCharsPerLine": 42,
    "maxLines": 2
  }
}
