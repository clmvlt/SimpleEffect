{
  "id": "box",
  "style": {
    "fontFamily": "Inter",
    "fontWeight": 700,
    "italic": false,
    "fontSize": 54,
    "textCase": "normal",
    "lineHeight": 1.35,
    "textColor": "#ffffff",
    "activeColor": "#ffd600",
    "emphasisColor": "#3ee8ff",
    "outline": { "enabled": false, "color": "#000000", "width": 0 },
    "shadow": { "enabled": false, "color": "#00000099", "blur": 6, "offset": { "x": 0, "y": 2 } },
    "background": {
      "enabled": true,
      "color": "#000000cc",
      "padding": { "x": 18, "y": 8 },
      "cornerRadius": 10
    },
    "position": { "x": 0.5, "y": 0.86 },
    "animation": "boxPerLine",
    "highlightSpoken": false,
    "maxCharsPerLine": 30,
    "maxLines": 2
  }
}
